# Copy to .env and fill in. Read by docker compose and by backend tools run on the host.
# Never commit .env.

# ── LLM: any OpenAI-compatible endpoint. Uncomment ONE block. ────────────────────

# Local Ollama: free, runs on this machine. `ollama pull qwen2.5:3b` (1.9 GB, ~3 GB RAM);
# qwen2.5:7b is better if you have ~8 GB RAM free. From inside docker compose the host's
# Ollama is http://host.docker.internal:11434/v1; from the host, http://localhost:11434/v1.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# Ollama cloud: NOT free. The $0 plan bills every token (ollama.com/pricing, Nov 2026:
# gpt-oss:120b $0.15 in / $0.60 out per million). The same applies to "*-cloud" models
# run through a signed-in local Ollama. Key: https://ollama.com/settings/keys
# LLM_BASE_URL=https://ollama.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-oss:120b
# LLM_MODEL_FAST=gpt-oss:20b

# OpenAI: check your account's free allowance before relying on it.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini

# CPU inference is slow: a resume parse on qwen2.5:3b can take a couple of minutes.
LLM_TIMEOUT_SECONDS=300

# ── Embeddings ────────────────────────────────────────────────────────────────────
# local: fastembed BAAI/bge-small-en-v1.5 on CPU, no key needed.
# openai: text-embedding-3-small at 384 dimensions; needs EMBED_API_KEY.
# Switching provider means re-embedding every job (vectors aren't comparable).
EMBED_PROVIDER=local
# EMBED_API_KEY=sk-...

# ── Job ingestion ─────────────────────────────────────────────────────────────────
# Skills always come from the free dictionary scan. The optional LLM pass uses
# LLM_MODEL_FAST, one job per call, capped per run; keep it on a local model (free).
INGEST_LLM_SKILLS=false
INGEST_LLM_MAX_JOBS=25

# ── Smoke script presets (python -m scripts.smoke_llm --all) ──────────────────────
# OPENAI_API_KEY=sk-...
# OLLAMA_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────────
# For tools run on the host (alembic, pytest). Containers use the compose db.
# For Neon, paste the *direct* (non-pooler) connection string; sslmode=require is
# converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://matchlens:matchlens@localhost:5440/matchlens

# Comma-separated origins allowed to call the API (production: your Vercel URL).
CORS_ORIGINS=http://localhost:3100

# Host ports for docker compose.
# FRONTEND_PORT=3100
# BACKEND_PORT=8100
# DB_PORT=5440
