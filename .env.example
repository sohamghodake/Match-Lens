# Copy to .env and fill in. Read by docker compose and by backend tools run on the host.
# Never commit .env.

# ── LLM: any OpenAI-compatible endpoint. Uncomment ONE block. ────────────────────

# Ollama cloud (public demo default). Key: https://ollama.com/settings/keys
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss:120b
LLM_MODEL_FAST=gpt-oss:20b

# OpenAI. On the Free tier only gpt-5.4-mini has enough tokens/minute for re-ranking.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini
# LLM_MODEL_FAST=gpt-5.4-mini

# Local Ollama (free, ~8 GB RAM). From inside docker compose, the host's Ollama is
# http://host.docker.internal:11434/v1; from the host it's http://localhost:11434/v1.
# A signed-in local Ollama can also proxy cloud models, e.g. LLM_MODEL=gpt-oss:120b-cloud.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

LLM_TIMEOUT_SECONDS=120

# ── Embeddings ────────────────────────────────────────────────────────────────────
# local: fastembed BAAI/bge-small-en-v1.5 on CPU, no key needed.
# openai: text-embedding-3-small at 384 dimensions; needs EMBED_API_KEY.
# Switching provider means re-embedding every job (vectors aren't comparable).
EMBED_PROVIDER=local
# EMBED_API_KEY=sk-...

# ── Smoke script presets (python -m scripts.smoke_llm --all) ──────────────────────
# OPENAI_API_KEY=sk-...
# OLLAMA_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────────
# For tools run on the host (alembic, pytest). Containers use the compose db.
# For Neon, paste the *direct* (non-pooler) connection string; sslmode=require is
# converted for asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://matchlens:matchlens@localhost:5440/matchlens

# Comma-separated origins allowed to call the API (production: your Vercel URL).
CORS_ORIGINS=http://localhost:3100

# Host ports for docker compose.
# FRONTEND_PORT=3100
# BACKEND_PORT=8100
# DB_PORT=5440
